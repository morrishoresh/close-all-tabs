{
  "manifest_version": 3,
  "name": "Close All Tabs",
  "version": "1.0",
  "description": "Closes all open tabs and leaves a single new empty tab.",
  "permissions": ["tabs"],
  "action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Close All Tabs"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "close-all-tabs@example.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}

